{
  "name": "meridian-terminal",
  "private": true,
  "version": "0.1.0",
  "description": "Meridian Terminal — charting workstation and portfolio tracker with test-verified DeMark-style studies.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @meridian/web dev",
    "build": "turbo run build",
    "build:vercel": "turbo run build --filter=@meridian/web && node scripts/build-vercel.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run --project unit --project golden",
    "test:watch": "vitest",
    "test:golden": "vitest run --project golden",
    "test:coverage": "vitest run --coverage",
    "bench": "node scripts/bench-engine.mjs",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module"
}
