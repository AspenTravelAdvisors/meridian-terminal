# Copy to .env (never commit real values). On Vercel set these under Project → Settings → Environment Variables.

# AI Chart Analyst (optional). Without it the analyst returns a deterministic rule-based briefing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional premium data providers (free public sources are used when unset).
TWELVE_DATA_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Comma-separated list of origins allowed to call /api from other sites (default: same-origin only).
ALLOWED_ORIGINS=

# Optional e-mail alert delivery through Resend (https://resend.com). Webhook alerts need no configuration.
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# ── Accounts, sync and background alerts (docs/ACCOUNTS.md) ──────────────────
# Postgres. On Vercel: Storage → Create Database → Neon sets this automatically. Locally, leave empty to use the
# embedded Postgres in .meridian-data/ (override the folder with MERIDIAN_DATA_DIR).
DATABASE_URL=
MERIDIAN_DATA_DIR=
# Invite code for accounts after the first; without it only the first (owner) account can be created.
SIGNUP_CODE=
# Protects /api/cron/alerts (Vercel Cron sends it as a Bearer token; external schedulers must too).
CRON_SECRET=
# Build-time cron schedule for the alert scheduler. Default once a day (Vercel Hobby limit); "* * * * *" on Pro; "off" disables.
ALERT_CRON_SCHEDULE=
# Web Push keys. Leave empty to have them generated once and kept in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
