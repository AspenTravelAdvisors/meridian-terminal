# Copy to .env (never commit real values). On Vercel set these under Project → Settings → Environment Variables.

# AI Chart Analyst (optional). Without it the analyst returns a deterministic rule-based briefing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional premium data providers (free public sources are used when unset).
TWELVE_DATA_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Comma-separated list of origins allowed to call /api from other sites (default: same-origin only).
ALLOWED_ORIGINS=
